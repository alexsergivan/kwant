{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["deb", "appimage"],
    "longDescription": "kwant runs a team of AI bots on your computer: the kwant server and its web UI in one desktop app, with a tray icon.",
    "linux": {
      "deb": {
        "depends": ["python3", "python3-venv", "xdg-utils"],
        "recommends": ["zenity"],
        "section": "devel"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
