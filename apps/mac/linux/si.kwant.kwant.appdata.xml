<?xml version="1.0" encoding="UTF-8"?>
<!--
  AppStream metainfo for the Linux app, installed as /usr/share/metainfo/si.kwant.kwant.appdata.xml
  in the AppImage and the .deb (tauri.linux.conf.json). The .appdata.xml suffix is the one the
  AppImage catalog's linter looks for. linux.yml rewrites the <release> entry to the version it
  builds and validates the result with appstreamcli.
-->
<component type="desktop-application">
  <id>si.kwant.kwant</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-only</project_license>
  <name>kwant</name>
  <summary>Your team of AI bots</summary>
  <developer id="si.kwant">
    <name>The kwant maintainer</name>
  </developer>
  <description>
    <p>
      kwant gives you a team of AI bots that share chats, hand work to each other with an
      @mention and get it done on their own, on a schedule or while you are away. Each message
      goes to the bot that fits, and the reply says why.
    </p>
    <p>
      Work shows up as cards on a Mission board, and a task turns Verified only when its check
      passes. The app runs the kwant server and its web app on your computer, with a tray icon,
      and updates itself with signed updates.
    </p>
  </description>
  <launchable type="desktop-id">kwant.desktop</launchable>
  <url type="homepage">https://kwant.si</url>
  <url type="bugtracker">https://github.com/alexsergivan/kwant/issues</url>
  <url type="vcs-browser">https://github.com/alexsergivan/kwant</url>
  <screenshots>
    <screenshot type="default">
      <caption>A team of bots discussing a question in one channel</caption>
      <image>https://kwant.si/assets/media/desktop-team-discussion-1440.webp</image>
    </screenshot>
  </screenshots>
  <provides>
    <binary>kwant</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.6.8" date="2026-11-03"/>
  </releases>
</component>
